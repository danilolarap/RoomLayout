
{
  "name": "roomlayout",
  "version": "1.0.0",
  "description": "RoomLayout LIGHT 3D",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "three": "0.128.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.roomlayout.desktop",
    "productName": "RoomLayout",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "login.html",
      "css/**/*",
      "js/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Graphics"
    },
    "mac": {
      "target": ["dmg"],
      "identity": null
    }
  }
}
